# Juego online (opcional). Copia este archivo como .env.local para desarrollo
# y pon los mismos valores en Vercel → Settings → Environment Variables.
# Sin ellas el juego funciona igual, sin el botón de sala online.
# Son públicas (van en el navegador): usa la clave "anon" / "publishable", nunca la "service_role".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
